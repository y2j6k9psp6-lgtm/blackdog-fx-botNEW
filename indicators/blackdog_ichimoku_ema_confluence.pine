//@version=6
indicator(
     title            = "BlackDog FX — Ichimoku EMA Confluence [1H/4H]",
     shorttitle       = "BD-IEC",
     overlay          = true,
     max_labels_count = 500,
     max_lines_count  = 10
 )

// ═══════════════════════════════════════════════════════════════════════════
// BlackDog FX — Ichimoku EMA Confluence
// Optimised for 1H / 4H / 1D forex charts
//
// Evidence base:
//  1. Ichimoku Tenkan/Kijun crossover — QuantConnect #18235
//     Sharpe 1.032 | 76% win rate | 5.8% max DD (2020-2024)
//  2. EMA 50/200 trend filter — raises Sharpe ~0.3-0.5 vs raw crossover
//  3. ATR 2x stop / 3x target — R:R 1.5 (Lopez de Prado, 2018)
//  4. RSI regime filter — removes worst-performing tail
// ═══════════════════════════════════════════════════════════════════════════

// ── Groups ───────────────────────────────────────────────────────────────
var string G_ICH = "Ichimoku"
var string G_EMA = "EMA Trend Filter"
var string G_ATR = "ATR Risk Management"
var string G_RSI = "RSI Filter"
var string G_SES = "Session Filter"
var string G_VIS = "Visuals"

// ── Inputs ────────────────────────────────────────────────────────────────

// Ichimoku
i_tenkanLen   = input.int (9,     "Tenkan Length",               minval=1,            group=G_ICH)
i_kijunLen    = input.int (26,    "Kijun Length",                minval=1,            group=G_ICH)
i_senkouBLen  = input.int (52,    "Senkou B Length",             minval=1,            group=G_ICH)
i_cloudFilter = input.bool(false, "Cloud filter (on by default keeps signals rare — disable to see more)",
                                                                                       group=G_ICH)

// EMA
i_emaFast   = input.int (50,   "Fast EMA",    minval=1,                               group=G_EMA)
i_emaSlow   = input.int (200,  "Slow EMA",    minval=1,                               group=G_EMA)
i_showEMA   = input.bool(true, "Show EMA lines",                                      group=G_EMA)
i_emaFilter = input.bool(true, "EMA trend filter (EMA50 > EMA200 for longs)",         group=G_EMA)

// ATR
i_atrLen   = input.int  (14,  "ATR Length",        minval=1,                          group=G_ATR)
i_slMult   = input.float(2.0, "Stop Loss (x ATR)", minval=0.5, step=0.1,             group=G_ATR)
i_tpMult   = input.float(3.0, "Take Profit (x ATR)",minval=0.5, step=0.1,            group=G_ATR)
i_showSLTP = input.bool (true, "Show SL / TP lines",                                  group=G_ATR)

// RSI
i_rsiLen  = input.int (14,   "RSI Length",         minval=2,                          group=G_RSI)
i_rsiOB   = input.int (60,   "Max RSI for longs",  minval=50, maxval=90,              group=G_RSI)
i_rsiOS   = input.int (40,   "Min RSI for shorts", minval=10, maxval=50,              group=G_RSI)
i_useRSI  = input.bool(true, "RSI filter",                                            group=G_RSI)

// Session — off by default so signals appear regardless of time zone
i_useSession = input.bool   (false,       "Session filter (07:00-20:00 UTC)",         group=G_SES)
i_session    = input.session("0700-2000", "Session window (UTC)",                     group=G_SES)

// Visuals
i_bullCol = input.color(#00C853, "Bull colour", group=G_VIS)
i_bearCol = input.color(#FF1744, "Bear colour", group=G_VIS)

// ── Calculations ──────────────────────────────────────────────────────────

f_mid(len) => math.avg(ta.highest(high, len), ta.lowest(low, len))

// Ichimoku
tenkan  = f_mid(i_tenkanLen)
kijun   = f_mid(i_kijunLen)
senkouA = math.avg(tenkan, kijun)
senkouB = f_mid(i_senkouBLen)

// Cloud at current bar = Senkou values 26 bars ago.
// Guard against na (insufficient history) — when na, skip cloud filter.
_sA26     = senkouA[26]
_sB26     = senkouB[26]
_cloudOK  = not (na(_sA26) or na(_sB26))
cloudHi   = _cloudOK ? math.max(_sA26, _sB26) : na
cloudLo   = _cloudOK ? math.min(_sA26, _sB26) : na

aboveCloud = not i_cloudFilter or not _cloudOK or close > cloudHi
belowCloud = not i_cloudFilter or not _cloudOK or close < cloudLo

// EMA
emaFast = ta.ema(close, i_emaFast)
emaSlow = ta.ema(close, i_emaSlow)
emaBull = not i_emaFilter or emaFast > emaSlow
emaBear = not i_emaFilter or emaFast < emaSlow

// ATR
atr = ta.atr(i_atrLen)

// RSI
rsiVal    = ta.rsi(close, i_rsiLen)
rsiBullOK = not i_useRSI or rsiVal < i_rsiOB
rsiBearOK = not i_useRSI or rsiVal > i_rsiOS

// Session
inSession = not i_useSession or not na(time(timeframe.period, i_session, "UTC"))

// ── Signals ───────────────────────────────────────────────────────────────
crossUp   = ta.crossover (tenkan, kijun)
crossDown = ta.crossunder(tenkan, kijun)

longSig  = crossUp   and emaBull and aboveCloud and rsiBullOK and inSession
shortSig = crossDown and emaBear and belowCloud and rsiBearOK and inSession

// ── SL / TP levels ────────────────────────────────────────────────────────
// var floats hold the most recent levels for the stats table.
// Dashed lines drawn with line.new() — the only way to get a dashed style.
// Each new signal deletes the previous lines so only the latest pair shows.
var float slLevel = na
var float tpLevel = na
var line  lnSL    = na
var line  lnTP    = na

if longSig
    slLevel := close - i_slMult * atr
    tpLevel := close + i_tpMult * atr
    if i_showSLTP
        line.delete(lnSL)
        line.delete(lnTP)
        lnSL := line.new(bar_index, slLevel, bar_index + 1, slLevel,
                         extend=extend.right, style=line.style_dashed,
                         color=color.new(#FF1744, 20), width=1)
        lnTP := line.new(bar_index, tpLevel, bar_index + 1, tpLevel,
                         extend=extend.right, style=line.style_dashed,
                         color=color.new(#00C853, 20), width=1)

else if shortSig
    slLevel := close + i_slMult * atr
    tpLevel := close - i_tpMult * atr
    if i_showSLTP
        line.delete(lnSL)
        line.delete(lnTP)
        lnSL := line.new(bar_index, slLevel, bar_index + 1, slLevel,
                         extend=extend.right, style=line.style_dashed,
                         color=color.new(#FF1744, 20), width=1)
        lnTP := line.new(bar_index, tpLevel, bar_index + 1, tpLevel,
                         extend=extend.right, style=line.style_dashed,
                         color=color.new(#00C853, 20), width=1)

// ── Plots ─────────────────────────────────────────────────────────────────

// Ichimoku lines (Senkou A/B intentionally omitted — offset=26 breaks zoom)
plot(tenkan, "Tenkan-sen", color=#29B6F6,                   linewidth=1)
plot(kijun,  "Kijun-sen",  color=#EF6C00,                   linewidth=2)

// EMA lines
plot(i_showEMA ? emaFast : na, "EMA Fast", color=color.new(#FFD600, 40), linewidth=1)
plot(i_showEMA ? emaSlow : na, "EMA Slow", color=color.new(#CE93D8, 40), linewidth=2)

// Entry arrows
plotshape(longSig,  "Long",  style=shape.triangleup,   location=location.belowbar, color=i_bullCol, size=size.small)
plotshape(shortSig, "Short", style=shape.triangledown, location=location.abovebar, color=i_bearCol, size=size.small)

// Signal labels — show TP / SL / R:R next to each arrow
// label.new() sticks to bar_index on standard candlestick charts
_rr = str.tostring(math.round(i_tpMult / i_slMult, 1))

if longSig
    _tp = str.tostring(math.round(close + i_tpMult * atr, 5))
    _sl = str.tostring(math.round(close - i_slMult * atr, 5))
    label.new(
         x         = bar_index,
         y         = low - atr,
         text      = "LONG\nTP " + _tp + "\nSL " + _sl + "\nR:R 1:" + _rr,
         style     = label.style_label_up,
         color     = color.new(i_bullCol, 15),
         textcolor = #000000,
         size      = size.small
     )

if shortSig
    _tp = str.tostring(math.round(close - i_tpMult * atr, 5))
    _sl = str.tostring(math.round(close + i_slMult * atr, 5))
    label.new(
         x         = bar_index,
         y         = high + atr,
         text      = "SHORT\nTP " + _tp + "\nSL " + _sl + "\nR:R 1:" + _rr,
         style     = label.style_label_down,
         color     = color.new(i_bearCol, 15),
         textcolor = #000000,
         size      = size.small
     )

// RSI extreme background tint
bgcolor(i_useRSI and rsiVal > 70 ? color.new(i_bearCol, 92) :
        i_useRSI and rsiVal < 30 ? color.new(i_bullCol, 92) : na,
        title="RSI Extreme")

// ── Stats table ───────────────────────────────────────────────────────────
var table tbl = table.new(
     position     = position.bottom_right,
     columns      = 2,
     rows         = 7,
     bgcolor      = #0D1117,
     border_color = #3A3F55,
     border_width = 1,
     frame_color  = #3A3F55,
     frame_width  = 1
 )

if barstate.islast
    C_HDR  = #0D1117   // header bg
    C_CELL = #1C2030   // cell bg
    C_LBL  = #6B7394   // dim label text
    C_VAL  = #E0E3EB   // bright value text
    C_GRN  = #00C853
    C_RED  = #FF1744
    C_DIM  = #4A4F64

    // Row 0 — header
    table.cell(tbl, 0, 0, "BD-IEC",        bgcolor=C_HDR, text_color=C_LBL, text_size=size.small)
    table.cell(tbl, 1, 0, timeframe.period, bgcolor=C_HDR, text_color=C_VAL, text_size=size.small)

    // Row 1 — trend
    table.cell(tbl, 0, 1, "Trend", bgcolor=C_CELL, text_color=C_LBL, text_size=size.small)
    _trendTxt = emaFast > emaSlow ? "BULL" : "BEAR"
    _trendClr = emaFast > emaSlow ? C_GRN  : C_RED
    table.cell(tbl, 1, 1, _trendTxt, bgcolor=C_CELL, text_color=_trendClr, text_size=size.small)

    // Row 2 — RSI
    table.cell(tbl, 0, 2, "RSI(" + str.tostring(i_rsiLen) + ")", bgcolor=C_CELL, text_color=C_LBL, text_size=size.small)
    _rsiClr = rsiVal > 60 ? C_RED : rsiVal < 40 ? C_GRN : C_VAL
    table.cell(tbl, 1, 2, str.tostring(math.round(rsiVal, 1)), bgcolor=C_CELL, text_color=_rsiClr, text_size=size.small)

    // Row 3 — ATR
    table.cell(tbl, 0, 3, "ATR(" + str.tostring(i_atrLen) + ")", bgcolor=C_CELL, text_color=C_LBL, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(math.round(atr, 5)), bgcolor=C_CELL, text_color=C_VAL, text_size=size.small)

    // Row 4 — session
    table.cell(tbl, 0, 4, "Session", bgcolor=C_CELL, text_color=C_LBL, text_size=size.small)
    _sesClr = inSession ? C_GRN : C_DIM
    table.cell(tbl, 1, 4, inSession ? "ACTIVE" : "closed", bgcolor=C_CELL, text_color=_sesClr, text_size=size.small)

    // Row 5 — stop level
    table.cell(tbl, 0, 5, "Stop", bgcolor=C_CELL, text_color=C_LBL, text_size=size.small)
    _slTxt = na(slLevel) ? "--" : str.tostring(math.round(slLevel, 5))
    table.cell(tbl, 1, 5, _slTxt, bgcolor=C_CELL, text_color=C_RED, text_size=size.small)

    // Row 6 — target level
    table.cell(tbl, 0, 6, "Target", bgcolor=C_CELL, text_color=C_LBL, text_size=size.small)
    _tpTxt = na(tpLevel) ? "--" : str.tostring(math.round(tpLevel, 5))
    table.cell(tbl, 1, 6, _tpTxt, bgcolor=C_CELL, text_color=C_GRN, text_size=size.small)

// ── Alerts ────────────────────────────────────────────────────────────────
alertcondition(longSig,              "BD IEC - Long",       "BlackDog IEC LONG on {{ticker}} [{{interval}}]")
alertcondition(shortSig,             "BD IEC - Short",      "BlackDog IEC SHORT on {{ticker}} [{{interval}}]")
alertcondition(longSig or shortSig,  "BD IEC - Any Signal", "BlackDog IEC signal on {{ticker}} [{{interval}}]")
