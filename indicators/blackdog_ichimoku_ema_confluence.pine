//@version=6
indicator(
     title      = "BlackDog FX — Ichimoku EMA Confluence [1H/4H]",
     shorttitle = "BD-IEC",
     overlay    = true
 )

// ═══════════════════════════════════════════════════════════════════════════
// BlackDog FX — Ichimoku EMA Confluence Indicator
// Optimised for 1H and 4H forex charts
//
// Evidence base (independently verified backtests):
//
//  1. ICHIMOKU TENKAN/KIJUN CROSSOVER
//     Source : QuantConnect forum #18235 (quantconnect.com)
//     Results: Sharpe 1.032 | Return 60.64% | Win rate 76% | Max DD 5.8%
//     Pairs  : USDJPY + EURUSD | Period: 2020-11-01 to 2024-11-01
//     Method : Tenkan-sen crosses Kijun-sen; paired with negatively
//              correlated second pair to smooth equity curve.
//
//  2. EMA VOLATILITY-FILTERED TREND CONFIRMATION
//     Source : YouQuant strategy #403462; QuantifiedStrategies.com corpus
//     Finding: EMA 50/200 filter raises Sharpe by ~0.3-0.5 vs raw
//              Ichimoku on daily/4H; reduces whipsaw in ranging markets.
//
//  3. ATR TRIPLE-BARRIER EXITS  (2x ATR stop, 3x ATR target, R:R 1.5)
//     Source : Lopez de Prado "Advances in Financial ML" (2018) ch.3;
//              validated via arxiv.org/pdf/2501.03938
//     Note   : 50% OOS haircut rule means in-sample Sharpe >= 1.0 needed
//              for live expectancy > 0. Minimum 1.5 R:R enforces this.
//
//  4. RSI REGIME FILTER
//     Source : QuantifiedStrategies.com; consistent finding across
//              64 backtested trend strategies — RSI < 60 on longs,
//              RSI > 40 on shorts cuts ~15-20% of trades but removes
//              the worst-performing tail.
//
// ═══════════════════════════════════════════════════════════════════════════

// ── Input groups ─────────────────────────────────────────────────────────
var string G_ICH = "Ichimoku"
var string G_EMA = "EMA Trend Filter"
var string G_ATR = "ATR Risk Management"
var string G_RSI = "RSI Filter"
var string G_SES = "Session Filter"
var string G_VIS = "Visuals"

// Ichimoku
i_tenkanLen   = input.int (9,    "Tenkan-sen Length",    minval=1, group=G_ICH)
i_kijunLen    = input.int (26,   "Kijun-sen Length",     minval=1, group=G_ICH)
i_senkouBLen  = input.int (52,   "Senkou Span B Length", minval=1, group=G_ICH)
i_cloudFilter = input.bool(true, "Cloud position filter (price must be above/below Kumo)", group=G_ICH)

// EMA
i_emaFast   = input.int (50,   "Fast EMA Period", minval=1, group=G_EMA)
i_emaSlow   = input.int (200,  "Slow EMA Period", minval=1, group=G_EMA)
i_showEMA   = input.bool(true, "Show EMA Lines",           group=G_EMA)
i_emaFilter = input.bool(true, "EMA trend filter (EMA50 > EMA200 for longs)", group=G_EMA)

// ATR
i_atrLen   = input.int  (14,  "ATR Length",          minval=1,           group=G_ATR)
i_slMult   = input.float(2.0, "Stop Loss  (x ATR)",  minval=0.5, step=0.1, group=G_ATR)
i_tpMult   = input.float(3.0, "Take Profit (x ATR)", minval=0.5, step=0.1, group=G_ATR)
i_showSLTP = input.bool (true, "Show SL/TP levels on chart",             group=G_ATR)

// RSI
i_rsiLen  = input.int (14,   "RSI Length",         minval=2,             group=G_RSI)
i_rsiOB   = input.int (60,   "Max RSI for longs",  minval=50, maxval=90, group=G_RSI)
i_rsiOS   = input.int (40,   "Min RSI for shorts", minval=10, maxval=50, group=G_RSI)
i_useRSI  = input.bool(true, "Enable RSI filter",                        group=G_RSI)

// Session (UTC)
i_useSession = input.bool   (true,        "Enable session filter", group=G_SES)
i_session    = input.session("0700-2000", "Active window (UTC)",   group=G_SES)

// Visuals
i_bullCol = input.color(color.new(#00C853, 0), "Bull colour", group=G_VIS)
i_bearCol = input.color(color.new(#FF1744, 0), "Bear colour", group=G_VIS)

// ── Helper ───────────────────────────────────────────────────────────────
f_mid(len) =>
    math.avg(ta.highest(high, len), ta.lowest(low, len))

// ── Ichimoku components ──────────────────────────────────────────────────
tenkan  = f_mid(i_tenkanLen)
kijun   = f_mid(i_kijunLen)
senkouA = math.avg(tenkan, kijun)
senkouB = f_mid(i_senkouBLen)

// Cloud at the current bar on screen = Senkou values from 26 bars ago
// (standard Ichimoku projects Senkou +26 bars forward)
cloudHi = math.max(senkouA[26], senkouB[26])
cloudLo = math.min(senkouA[26], senkouB[26])

// ── EMA trend filter ─────────────────────────────────────────────────────
emaFast = ta.ema(close, i_emaFast)
emaSlow = ta.ema(close, i_emaSlow)
emaBull = not i_emaFilter or emaFast > emaSlow
emaBear = not i_emaFilter or emaFast < emaSlow

// ── ATR ──────────────────────────────────────────────────────────────────
atr = ta.atr(i_atrLen)

// ── RSI ──────────────────────────────────────────────────────────────────
rsiVal    = ta.rsi(close, i_rsiLen)
rsiBullOK = not i_useRSI or rsiVal < i_rsiOB
rsiBearOK = not i_useRSI or rsiVal > i_rsiOS

// ── Session ──────────────────────────────────────────────────────────────
inSession = not i_useSession or not na(time(timeframe.period, i_session, "UTC"))

// ── Cloud position filter ────────────────────────────────────────────────
aboveCloud = not i_cloudFilter or close > cloudHi
belowCloud = not i_cloudFilter or close < cloudLo

// ── Signal logic ─────────────────────────────────────────────────────────
crossUp   = ta.crossover (tenkan, kijun)
crossDown = ta.crossunder(tenkan, kijun)

longSig  = crossUp   and emaBull and aboveCloud and rsiBullOK and inSession
shortSig = crossDown and emaBear and belowCloud and rsiBearOK and inSession

// ── SL / TP as persistent plot series ───────────────────────────────────
// var float + plot() keeps levels as bar series (always sticks on pan/zoom).
// Levels expire after 200 bars so stale prices don't distort the y-axis.
var float slLevel    = na
var float tpLevel    = na
var int   lastSigBar = 0

if longSig
    slLevel    := close - i_slMult * atr
    tpLevel    := close + i_tpMult * atr
    lastSigBar := bar_index
else if shortSig
    slLevel    := close + i_slMult * atr
    tpLevel    := close - i_tpMult * atr
    lastSigBar := bar_index

_slShow = i_showSLTP and not na(slLevel) and (bar_index - lastSigBar) <= 200
_tpShow = i_showSLTP and not na(tpLevel) and (bar_index - lastSigBar) <= 200

// ── Plots: Ichimoku lines ─────────────────────────────────────────────────
// Senkou A/B are not plotted — offset=26 causes TradingView to misalign
// the entire indicator on zoom. Cloud filter still works via cloudHi/cloudLo.
plot(tenkan, "Tenkan-sen", color=color.new(#29B6F6, 0), linewidth=1)
plot(kijun,  "Kijun-sen",  color=color.new(#EF6C00, 0), linewidth=2)

// ── Plots: EMA lines ─────────────────────────────────────────────────────
plot(i_showEMA ? emaFast : na, "EMA Fast", color=color.new(#FFD600, 60), linewidth=1)
plot(i_showEMA ? emaSlow : na, "EMA Slow", color=color.new(#CE93D8, 60), linewidth=2)

// ── Plots: SL / TP levels ────────────────────────────────────────────────
plot(_slShow ? slLevel : na, "Stop Loss",   color=color.new(#FF1744, 30), linewidth=1, style=plot.style_linebr)
plot(_tpShow ? tpLevel : na, "Take Profit", color=color.new(#00C853, 30), linewidth=1, style=plot.style_linebr)

// ── Plots: Entry arrows ───────────────────────────────────────────────────
plotshape(longSig,  "Long Signal",  style=shape.triangleup,
          location=location.belowbar, color=i_bullCol, size=size.auto)
plotshape(shortSig, "Short Signal", style=shape.triangledown,
          location=location.abovebar, color=i_bearCol, size=size.auto)

// ── Background: RSI extreme zones ────────────────────────────────────────
bgcolor(i_useRSI and rsiVal > 70 ? color.new(i_bearCol, 94) :
        i_useRSI and rsiVal < 30 ? color.new(i_bullCol, 94) : na,
        title="RSI Extreme")

// ── Table: live stats ────────────────────────────────────────────────────
var table tbl = table.new(position.bottom_right, 2, 7,
                          border_width=1,
                          border_color=color.new(color.gray, 70),
                          frame_color =color.new(color.gray, 70),
                          frame_width =1)

if barstate.islast
    // Solid dark backgrounds — readable on both light and dark chart themes
    _bg  = #1C2030   // dark navy cell
    _hbg = #0D1117   // darker header
    _fg  = #E0E3EB   // off-white text

    table.cell(tbl, 0, 0, "BD-IEC",        bgcolor=_hbg, text_color=#A0A8C0, text_size=size.small)
    table.cell(tbl, 1, 0, timeframe.period, bgcolor=_hbg, text_color=#E0E3EB, text_size=size.small)

    table.cell(tbl, 0, 1, "Trend", bgcolor=_bg, text_color=#A0A8C0, text_size=size.small)
    _trendStr   = emaFast > emaSlow ? "BULL" : "BEAR"
    _trendColor = emaFast > emaSlow ? #00C853 : #FF1744
    table.cell(tbl, 1, 1, _trendStr, bgcolor=_bg, text_color=_trendColor, text_size=size.small)

    table.cell(tbl, 0, 2, "RSI", bgcolor=_bg, text_color=#A0A8C0, text_size=size.small)
    _rsiColor = rsiVal > 60 ? #FF1744 : rsiVal < 40 ? #00C853 : _fg
    table.cell(tbl, 1, 2, str.tostring(math.round(rsiVal, 1)),
               bgcolor=_bg, text_color=_rsiColor, text_size=size.small)

    table.cell(tbl, 0, 3, "ATR", bgcolor=_bg, text_color=#A0A8C0, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(math.round(atr, 5)), bgcolor=_bg, text_color=_fg, text_size=size.small)

    table.cell(tbl, 0, 4, "Session", bgcolor=_bg, text_color=#A0A8C0, text_size=size.small)
    _sesColor = inSession ? #00C853 : #666B80
    table.cell(tbl, 1, 4, inSession ? "ACTIVE" : "closed",
               bgcolor=_bg, text_color=_sesColor, text_size=size.small)

    table.cell(tbl, 0, 5, "Stop", bgcolor=_bg, text_color=#A0A8C0, text_size=size.small)
    table.cell(tbl, 1, 5, na(slLevel) ? "--" : str.tostring(math.round(slLevel, 5)),
               bgcolor=_bg, text_color=#FF6B6B, text_size=size.small)

    table.cell(tbl, 0, 6, "Target", bgcolor=_bg, text_color=#A0A8C0, text_size=size.small)
    table.cell(tbl, 1, 6, na(tpLevel) ? "--" : str.tostring(math.round(tpLevel, 5)),
               bgcolor=_bg, text_color=#00E676, text_size=size.small)

// ── Alert conditions ──────────────────────────────────────────────────────
alertcondition(longSig,  "BD IEC - Long",       "BlackDog IEC LONG on {{ticker}} [{{interval}}]")
alertcondition(shortSig, "BD IEC - Short",      "BlackDog IEC SHORT on {{ticker}} [{{interval}}]")
alertcondition(longSig or shortSig, "BD IEC - Any Signal", "BlackDog IEC signal on {{ticker}} [{{interval}}]")
