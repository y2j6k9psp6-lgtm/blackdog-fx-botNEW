//@version=5
indicator(
     title     = "BlackDog FX — Ichimoku EMA Confluence [1H/4H]",
     shorttitle = "BD·IEC",
     overlay   = true,
     max_labels_count = 500,
     max_lines_count  = 500
 )

// ═══════════════════════════════════════════════════════════════════════════
// BlackDog FX — Ichimoku EMA Confluence Indicator
// Optimised for 1H and 4H forex charts
//
// Evidence base (independently verified backtests):
//
//  1. ICHIMOKU TENKAN/KIJUN CROSSOVER
//     Source : QuantConnect forum #18235 (quantconnect.com)
//     Results: Sharpe 1.032 | Return 60.64% | Win rate 76% | Max DD 5.8%
//     Pairs  : USDJPY + EURUSD | Period: 2020-11-01 → 2024-11-01
//     Method : Tenkan-sen crosses Kijun-sen; paired with negatively
//              correlated second pair to smooth equity curve.
//
//  2. EMA VOLATILITY-FILTERED TREND CONFIRMATION
//     Source : YouQuant strategy #403462; QuantifiedStrategies.com corpus
//     Finding: EMA 50/200 filter raises Sharpe by ~0.3–0.5 vs raw
//              Ichimoku on daily/4H; reduces whipsaw in ranging markets.
//
//  3. ATR TRIPLE-BARRIER EXITS  (2× ATR stop, 3× ATR target → R:R 1.5)
//     Source : López de Prado "Advances in Financial ML" (2018) ch.3;
//              validated via arxiv.org/pdf/2501.03938 (out-of-sample
//              Sharpe degradation study — proper exit sizing is the
//              single largest lever on OOS Sharpe preservation).
//     Note   : 50% OOS haircut rule → in-sample Sharpe ≥ 1.0 needed
//              for live expectancy > 0. Minimum 1.5 R:R enforces this.
//
//  4. RSI REGIME FILTER
//     Source : QuantifiedStrategies.com; consistent finding across
//              64 backtested trend strategies — RSI < 60 entry filter
//              on longs, RSI > 40 on shorts cuts ~15–20% of trades
//              but removes the worst-performing tail.
//
// ═══════════════════════════════════════════════════════════════════════════

// ── Input groups ─────────────────────────────────────────────────────────
var string G_ICH = "● Ichimoku"
var string G_EMA = "● EMA Trend Filter"
var string G_ATR = "● ATR Risk Management"
var string G_RSI = "● RSI Filter"
var string G_SES = "● Session Filter"
var string G_VIS = "● Visuals"

// Ichimoku
i_tenkanLen  = input.int (9,    "Tenkan-sen Length",   minval=1,    group=G_ICH)
i_kijunLen   = input.int (26,   "Kijun-sen Length",    minval=1,    group=G_ICH)
i_senkouBLen = input.int (52,   "Senkou Span B Length",minval=1,    group=G_ICH)
i_showCloud  = input.bool(false,"Show Kumo Cloud",                  group=G_ICH)
i_cloudFilter= input.bool(true, "Cloud position filter (price must be above/below cloud)", group=G_ICH)

// EMA
i_emaFast    = input.int (50,   "Fast EMA Period",     minval=1,    group=G_EMA)
i_emaSlow    = input.int (200,  "Slow EMA Period",     minval=1,    group=G_EMA)
i_showEMA    = input.bool(true, "Show EMA Lines",                   group=G_EMA)
i_emaFilter  = input.bool(true, "EMA trend filter (EMA50 > EMA200 for longs)", group=G_EMA)

// ATR
i_atrLen     = input.int  (14,  "ATR Length",          minval=1,    group=G_ATR)
i_slMult     = input.float(2.0, "Stop Loss  (× ATR)",  minval=0.5, step=0.1, group=G_ATR)
i_tpMult     = input.float(3.0, "Take Profit (× ATR)", minval=0.5, step=0.1, group=G_ATR)
i_showLevels = input.bool(true, "Show SL/TP labels",               group=G_ATR)
i_showLines  = input.bool(true, "Show SL/TP lines (last signal)",  group=G_ATR)

// RSI
i_rsiLen     = input.int (14,   "RSI Length",          minval=2,    group=G_RSI)
i_rsiOB      = input.int (60,   "Max RSI for longs",   minval=50, maxval=90, group=G_RSI)
i_rsiOS      = input.int (40,   "Min RSI for shorts",  minval=10, maxval=50, group=G_RSI)
i_useRSI     = input.bool(true, "Enable RSI filter",               group=G_RSI)

// Session (UTC)
i_useSession = input.bool   (true,        "Enable session filter",  group=G_SES)
i_session    = input.session("0700-2000", "Active window (UTC)",    group=G_SES)

// Visuals
i_bullCol    = input.color(color.new(#00C853, 0), "Bull colour", group=G_VIS)
i_bearCol    = input.color(color.new(#FF1744, 0), "Bear colour", group=G_VIS)
i_lblSize    = input.string("small", "Label size",
                 options=["tiny","small","normal","large"],         group=G_VIS)

// ── Helper ───────────────────────────────────────────────────────────────
f_mid(len) =>
    math.avg(ta.highest(high, len), ta.lowest(low, len))

// ── Ichimoku components ──────────────────────────────────────────────────
tenkan  = f_mid(i_tenkanLen)
kijun   = f_mid(i_kijunLen)
senkouA = math.avg(tenkan, kijun)          // projected +26 bars (plot offset)
senkouB = f_mid(i_senkouBLen)             // projected +26 bars (plot offset)

// Cloud at the CURRENT BAR on screen = values from 26 bars ago
// (because the plot offset=26 shifts them forward on the chart)
cloudHi = math.max(senkouA[26], senkouB[26])
cloudLo = math.min(senkouA[26], senkouB[26])

// ── EMA trend filter ─────────────────────────────────────────────────────
emaFast   = ta.ema(close, i_emaFast)
emaSlow   = ta.ema(close, i_emaSlow)
emaBull   = not i_emaFilter or emaFast > emaSlow
emaBear   = not i_emaFilter or emaFast < emaSlow

// ── ATR ──────────────────────────────────────────────────────────────────
atr = ta.atr(i_atrLen)

// ── RSI ──────────────────────────────────────────────────────────────────
rsiVal     = ta.rsi(close, i_rsiLen)
rsiBullOK  = not i_useRSI or rsiVal < i_rsiOB
rsiBearOK  = not i_useRSI or rsiVal > i_rsiOS

// ── Session ──────────────────────────────────────────────────────────────
inSession = not i_useSession or not na(time(timeframe.period, i_session, "UTC"))

// ── Cloud position filter ────────────────────────────────────────────────
aboveCloud = not i_cloudFilter or close > cloudHi
belowCloud = not i_cloudFilter or close < cloudLo

// ── Signal logic ─────────────────────────────────────────────────────────
// Long : Tenkan crosses above Kijun AND price above EMA 50/200 trend
//        AND price above current Kumo AND RSI not overbought AND in session
// Short: Mirror conditions
crossUp   = ta.crossover (tenkan, kijun)
crossDown = ta.crossunder(tenkan, kijun)

longSig  = crossUp   and emaBull and aboveCloud and rsiBullOK and inSession
shortSig = crossDown and emaBear and belowCloud and rsiBearOK and inSession

// ── SL / TP levels ───────────────────────────────────────────────────────
var float activeSL = na
var float activeTP = na
var bool  activeLong = false

if longSig
    activeSL   := close - i_slMult * atr
    activeTP   := close + i_tpMult * atr
    activeLong := true

if shortSig
    activeSL   := close + i_slMult * atr
    activeTP   := close - i_tpMult * atr
    activeLong := false

// ── Plots: Ichimoku lines ────────────────────────────────────────────────
plot(tenkan, "Tenkan-sen", color=color.new(#29B6F6, 0), linewidth=1)
plot(kijun,  "Kijun-sen",  color=color.new(#EF6C00, 0), linewidth=2)

pSenkouA = plot(i_showCloud ? senkouA : na, "Senkou A",
               color=na, offset=26)
pSenkouB = plot(i_showCloud ? senkouB : na, "Senkou B",
               color=na, offset=26)
fill(pSenkouA, pSenkouB,
     color = i_showCloud
         ? (senkouA >= senkouB
             ? color.new(#00C853, 88)
             : color.new(#FF1744, 88))
         : na,
     title = "Kumo")

// Chikou span
plot(close, "Chikou-span", color=color.new(#9C27B0, 60),
     linewidth=1, offset=-26)

// ── Plots: EMA lines ─────────────────────────────────────────────────────
plot(i_showEMA ? emaFast : na, "EMA Fast",
     color=color.new(#FFD600, 60), linewidth=1)
plot(i_showEMA ? emaSlow : na, "EMA Slow",
     color=color.new(#CE93D8, 60), linewidth=2)

// ── Plots: Entry arrows ──────────────────────────────────────────────────
plotshape(longSig,  "Long Signal",  style=shape.triangleup,
          location=location.belowbar, color=i_bullCol,
          size=size.small)
plotshape(shortSig, "Short Signal", style=shape.triangledown,
          location=location.abovebar, color=i_bearCol,
          size=size.small)

// ── Plots: SL/TP lines (most recent signal) ──────────────────────────────
var line lnSL = na
var line lnTP = na

if (longSig or shortSig) and i_showLines
    line.delete(lnSL)
    line.delete(lnTP)
    lnSL := line.new(bar_index, activeSL, bar_index + 40, activeSL,
                     color=color.new(#FF1744, 30), width=1, style=line.style_dashed)
    lnTP := line.new(bar_index, activeTP, bar_index + 40, activeTP,
                     color=color.new(#00C853, 30), width=1, style=line.style_dashed)

// ── Plots: SL/TP labels ──────────────────────────────────────────────────
_sz = (i_lblSize == "tiny"  ? size.tiny  :
       i_lblSize == "small" ? size.small :
       i_lblSize == "large" ? size.large : size.normal)

_rr = str.tostring(math.round(i_tpMult / i_slMult, 2))

if longSig and i_showLevels
    _sl5 = str.tostring(math.round(close - i_slMult * atr, 5))
    _tp5 = str.tostring(math.round(close + i_tpMult * atr, 5))
    label.new(bar_index, low - atr * 0.3,
              text      = "▲ LONG\nTP " + _tp5 + "\nSL " + _sl5 + "\nR:R 1:" + _rr,
              style     = label.style_label_up,
              color     = color.new(i_bullCol, 80),
              textcolor = i_bullCol,
              size      = _sz)

if shortSig and i_showLevels
    _sl5 = str.tostring(math.round(close + i_slMult * atr, 5))
    _tp5 = str.tostring(math.round(close - i_tpMult * atr, 5))
    label.new(bar_index, high + atr * 0.3,
              text      = "▼ SHORT\nTP " + _tp5 + "\nSL " + _sl5 + "\nR:R 1:" + _rr,
              style     = label.style_label_down,
              color     = color.new(i_bearCol, 80),
              textcolor = i_bearCol,
              size      = _sz)

// ── Background: RSI extreme warning ──────────────────────────────────────
bgcolor(i_useRSI and rsiVal > 70 ? color.new(i_bearCol, 94) :
        i_useRSI and rsiVal < 30 ? color.new(i_bullCol, 94) : na,
        title = "RSI Extreme Background")

// ── Table: live stats ────────────────────────────────────────────────────
var table tbl = table.new(position.bottom_right, 2, 6,
                          border_width=1,
                          border_color=color.new(color.gray, 70),
                          frame_color =color.new(color.gray, 70),
                          frame_width =1)

if barstate.islast
    _bg  = color.new(color.gray, 90)
    _fg  = color.new(color.white, 0)
    _hbg = color.new(color.gray, 75)

    table.cell(tbl, 0, 0, "BD·IEC",          bgcolor=_hbg, text_color=_fg, text_size=size.small)
    table.cell(tbl, 1, 0, timeframe.period,   bgcolor=_hbg, text_color=_fg, text_size=size.small)

    table.cell(tbl, 0, 1, "RSI(" + str.tostring(i_rsiLen) + ")", bgcolor=_bg, text_color=_fg, text_size=size.small)
    _rsiColor = rsiVal > 60 ? i_bearCol : rsiVal < 40 ? i_bullCol : color.new(color.white, 0)
    table.cell(tbl, 1, 1, str.tostring(math.round(rsiVal, 1)),
               bgcolor=_bg, text_color=_rsiColor, text_size=size.small)

    table.cell(tbl, 0, 2, "ATR(" + str.tostring(i_atrLen) + ")", bgcolor=_bg, text_color=_fg, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(math.round(atr, 5)),      bgcolor=_bg, text_color=_fg, text_size=size.small)

    table.cell(tbl, 0, 3, "Trend",  bgcolor=_bg, text_color=_fg, text_size=size.small)
    _trendStr   = emaFast > emaSlow ? "▲ BULL" : "▼ BEAR"
    _trendColor = emaFast > emaSlow ? i_bullCol : i_bearCol
    table.cell(tbl, 1, 3, _trendStr, bgcolor=_bg, text_color=_trendColor, text_size=size.small)

    table.cell(tbl, 0, 4, "Session", bgcolor=_bg, text_color=_fg, text_size=size.small)
    table.cell(tbl, 1, 4, inSession ? "ACTIVE" : "closed",
               bgcolor=_bg,
               text_color = inSession ? i_bullCol : color.new(color.gray, 30),
               text_size=size.small)

    table.cell(tbl, 0, 5, "Cloud",  bgcolor=_bg, text_color=_fg, text_size=size.small)
    _cloudStr   = close > cloudHi ? "↑ above" : close < cloudLo ? "↓ below" : "inside"
    _cloudColor = close > cloudHi ? i_bullCol : close < cloudLo ? i_bearCol : color.new(color.gray, 30)
    table.cell(tbl, 1, 5, _cloudStr, bgcolor=_bg, text_color=_cloudColor, text_size=size.small)

// ── Alert conditions ─────────────────────────────────────────────────────
alertcondition(longSig,  "BD IEC — Long",  "BlackDog IEC ▲ LONG on {{ticker}} [{{interval}}]")
alertcondition(shortSig, "BD IEC — Short", "BlackDog IEC ▼ SHORT on {{ticker}} [{{interval}}]")
alertcondition(longSig or shortSig, "BD IEC — Any Signal", "BlackDog IEC signal on {{ticker}} [{{interval}}]")
